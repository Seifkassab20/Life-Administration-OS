# Life Administration OS Backend Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL with pgvector)
# Use PostgreSQL when docker or local pg is running:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/life_admin_os
# If true or if PostgreSQL connection fails, falls back gracefully to SQLite + in-memory vector indexing for dev
SQLITE_FALLBACK=True
SQLITE_DATABASE_PATH=./life_admin.db

# Storage
STORAGE_BACKEND=local # Options: 'local' or 'supabase'
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI & LLM Providers (Pluggable)
# Options: 'gemini', 'openai', 'groq', or 'rule_based'
LLM_PROVIDER=rule_based
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security & Demo
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
JWT_SECRET_KEY=life-admin-os-super-secret-jwt-key-for-development-only-replace-in-production
JWT_ALGORITHM=HS256
